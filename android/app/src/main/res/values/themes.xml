<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- No AppCompat. The app has no Android-side UI at all — one WebView
         filling the window — so a platform theme is both sufficient and one
         fewer dependency. -->
    <style name="Theme.Ringshift" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <!-- The activity is drawn edge to edge and the bars are hidden anyway;
             light icons are what shows during the transient swipe-down. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
