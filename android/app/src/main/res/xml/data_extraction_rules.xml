<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. Same intent as backup_rules.xml: the progress is
     worth keeping, the cache is not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="app_webview/GPUCache" />
        <exclude domain="file" path="app_webview/Service Worker" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="app_webview/GPUCache" />
    </device-transfer>
</data-extraction-rules>
