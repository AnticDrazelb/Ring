<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The game is dark in every light. This exists so the system does not
         substitute a default light theme when the device is in day mode. -->
    <style name="Theme.Ringshift" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
