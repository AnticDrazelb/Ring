<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The game's haptics are navigator.vibrate, and without this permission
         that call silently does nothing: no crash, no log, just a game that
         never buzzes. It is a normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- WebGL. A device without GLES2 gets the game's "cannot run" card, but
         it should not be offered the install in the first place. -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- THE GAME STILL HAS NO NETWORK. THE ADS DO.

         This permission arrived with AdMob and it is worth being honest about
         what it changes: before ads, the app could not reach the internet at
         all, which is a very strong thing to be able to say. It no longer
         can be. What is still true, and is enforced rather than promised, is
         that the GAME cannot: the WebView carries blockNetworkLoads = true
         and is served from inside the APK, so every byte on the wire belongs
         to the Google Mobile Ads SDK and none of it to the page. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required from Android 13 for the SDK to read the advertising id.
         Without it ads still serve, but only non-personalised ones. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Ringshift"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <!-- enableOnBackInvokedCallback: Android 13 introduced predictive
             back, and an app that has not opted in gets the legacy path with
             no animation and, from Android 15, increasingly odd edge cases.
             The activity already routes Back through OnBackPressedDispatcher,
             which is the API predictive back is built on, so opting in costs
             nothing and is the difference between a modern Back and one that
             feels like a 2015 app. -->

        <!-- The AdMob app id. The value comes from manifestPlaceholders in
             app/build.gradle.kts; the SDK crashes at startup if it is absent
             or malformed, which is at least a loud way to fail. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Do not initialise on the main thread at app start; AdHost does it
             off the critical path once the game is already drawing. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Ringshift"
            android:windowSoftInputMode="adjustNothing"
            android:resizeableActivity="true"
            android:immersive="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|keyboard|navigation|uiMode|fontScale|locale|layoutDirection">

            <!-- ROTATION MUST NOT RESTART THE ACTIVITY.
                 Every one of those configChanges would otherwise recreate the
                 activity, which reloads the WebView, which restarts the game
                 from the studio card and abandons the run in progress. With
                 them declared the WebView simply resizes and the game's own
                 resize handler does the rest — which is already tested at
                 eight viewport sizes including both landscape orientations. -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
